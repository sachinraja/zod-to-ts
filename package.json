{
	"name": "zod-to-ts",
	"version": "2.1.0",
	"type": "module",
	"description": "generate TypeScript types from your Zod schema",
	"author": {
		"name": "Sachin Raja",
		"url": "https://github.com/sachinraja"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/sachinraja/zod-to-ts.git"
	},
	"homepage": "https://github.com/sachinraja/zod-to-ts#readme",
	"bugs": {
		"url": "https://github.com/sachinraja/zod-to-ts/issues"
	},
	"zshy": {
		"exports": "./src/index.ts",
		"cjs": false
	},
	"files": [
		"dist"
	],
	"keywords": [
		"zod",
		"typescript",
		"generator"
	],
	"scripts": {
		"build": "zshy",
		"format": "biome format . --write",
		"lint": "pnpm run /^lint:/",
		"lint:biome": "biome check",
		"lint:types": "tsc",
		"test": "vitest"
	},
	"peerDependencies": {
		"typescript": "^7",
		"zod": "^3.25.0 || ^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@types/node": "24.7.2",
		"typescript": "7.0.2",
		"vite": "8.0.16",
		"vitest": "4.1.8",
		"zod": "4.4.3",
		"zshy": "0.7.2"
	},
	"packageManager": "pnpm@10.18.3",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	}
}
